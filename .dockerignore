# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 环境变量（含密钥，禁止入镜像）
.env

# 数据库与日志（运行时生成）
# 排除运行时生成的用户库；知识库向量库 knowledge_bases/agri_knowledge.db 必须保留
# （手动上传整个 modelscope_space 文件夹，该 db 需随镜像部署，供 RAGEngine 直接加载）
*.db
!knowledge_bases/agri_knowledge.db
logs/

# 前端构建产物与依赖（Docker 内重新构建）
frontend/node_modules/
frontend/dist/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/

# 系统
.DS_Store
Thumbs.db

# 文档（非必需）
*.md
!README.md
LICENSE
