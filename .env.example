# LLM_API_KEY 为你的 ModelScope Token（在创空间控制台以明文环境变量配置，不要提交到仓库）
# 例如：ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LLM_API_KEY=
LLM_API_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL=Qwen/Qwen3.8-27B
EMBEDDING_MODEL=bge-small-zh-v1.5
WEATHER_API_KEY=
WEATHER_SUBSCRIPTION_ID=
AMAP_API_KEY=

# ---------- 魔搭 OAuth 登录 ----------
# 创空间部署时由平台自动注入，本地调试才需要手填（本文件不要写入真实密钥）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_PROVIDER_URL=https://www.modelscope.cn
# 创空间域名，用于拼 redirect_uri（https://<STUDIO_HOST>/auth/callback）
STUDIO_HOST=
# 每次打开都向魔搭核验一次身份，确保换号后进入的是新账号（默认开启）
SSO_VERIFY_ON_ENTRY=true
# 演示登录：注入 STUDIO_HOST 时默认关闭，避免多人共用一个演示账号
# DEV_LOGIN_ENABLED=true
