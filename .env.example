# LLM_API_KEY 为你的 ModelScope Token（在创空间控制台以明文环境变量配置，不要提交到仓库）
# 例如：ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LLM_API_KEY=
LLM_API_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL=Qwen/Qwen3.8-27B
EMBEDDING_MODEL=bge-small-zh-v1.5
WEATHER_API_KEY=
WEATHER_SUBSCRIPTION_ID=
AMAP_API_KEY=

# ---------- 魔搭 OAuth（可选，默认不用） ----------
# 默认形态是免登录演示（见文末 AUTH_REQUIRED）；昵称+密码登录的代码仍在，
# 想切回账号登录只要把 AUTH_REQUIRED 打开。魔搭账号登录则再配下面这两项。
# 创空间部署时由平台自动注入，本地调试才需要手填（本文件不要写入真实密钥）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_PROVIDER_URL=https://www.modelscope.cn
# 创空间域名，用于拼 redirect_uri（https://<STUDIO_HOST>/auth/callback）
STUDIO_HOST=

# ---------- 访问形态 ----------
# 留空或 false = 免登录：进空间即用，没有会话 cookie 的请求统一归到 GUEST_USER_ID，
# 地块数据所有访客共享一份（data/users/guest/）；对话不落地，每次打开都是空白。
# true = 恢复登录门槛，未登录访问 /api/farm 等接口返回 401（前端需同步打开 flags.LOGIN_REQUIRED）。
AUTH_REQUIRED=
# 共享访客身份的 user_id，改动会让已有地块库换到新目录
GUEST_USER_ID=
